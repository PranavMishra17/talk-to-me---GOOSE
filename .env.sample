# Copy to .env. Never commit .env.
# Required: from cloud.livekit.io, Settings then Keys.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: the Jev decider. Without it Goose uses the keyword decider.
OPENROUTER_API_KEY=

# Optional: shown on the landing page.
GOOSE_PHONE_NUMBER=

# Optional: only with providers.own_keys: true in config.yaml, or scripts/voices.py.
CARTESIA_API_KEY=
